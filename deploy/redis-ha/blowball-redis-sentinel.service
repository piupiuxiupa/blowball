# blowball Redis 哨兵进程(三台各一个)
# 安装到 /etc/systemd/system/blowball-redis-sentinel.service;在三台
# blowball-redis 全部就绪后再启动(见 docs/redis-ha-deployment.md §6 步骤 3)。
[Unit]
Description=blowball Redis sentinel
After=network-online.target
Wants=network-online.target
# 故意不依赖本机 blowball-redis:哨兵必须在本机 redis 死掉时仍然活着参与仲裁

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-sentinel /etc/redis/sentinel.conf
Restart=always
RestartSec=3
RuntimeDirectory=redis
RuntimeDirectoryMode=0755
UMask=007
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# sentinel.conf 会被哨兵运行时重写(记录纪元/拓扑),必须可写
ReadWritePaths=/etc/redis /var/lib/redis

[Install]
WantedBy=multi-user.target
